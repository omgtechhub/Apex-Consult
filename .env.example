# ---------------------------------------------------------------------------
# Altivance — environment template
#
# Copy to `.env.local` (git-ignored) and fill in. Restart the dev server after
# any change: Next reads env files at startup, not per request.
# ---------------------------------------------------------------------------

# Postgres connection string. See README-ADMIN.md for getting one in ~3 min.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The scholarship pipeline API (the companion repo, usually on :3001).
SCHOLARSHIP_API_URL=http://localhost:3001


# ---------------------------------------------------------------------------
# Payments — Paystack
#
# Both keys come from the Paystack dashboard:
#   https://dashboard.paystack.com/#/settings/developers
#
# Test keys (sk_test_… / pk_test_…) take no real money and are what you want
# while developing. The /pay page shows a "Test mode" banner whenever the
# secret key is a test key, so a test payment can never be mistaken for a real
# one. Swap both to sk_live_… / pk_live_… to go live.
#
# Use a MATCHED PAIR. A test secret with a live public key, or the reverse,
# fails at checkout with an unhelpful error from Paystack.
# ---------------------------------------------------------------------------

# Server-side only. Signs API calls and verifies webhook signatures.
# NEVER prefix this with NEXT_PUBLIC_ — that would ship it to the browser and
# hand anyone who views source the ability to move money on your account.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Safe in the browser by design. Not used by the current redirect checkout,
# which initialises server-side; kept here because Paystack's inline popup and
# their test-card tooling both expect it.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
# Public site URL — OPTIONAL, and deliberately left unset in development.
#
# Used to build the absolute URL Paystack returns the customer to after
# checkout. When this is unset, that URL is derived per request from the host
# the customer is actually browsing on, which is what lets the same dev server
# be paid from this PC, from a phone on the Wi-Fi, and through a tunnel without
# any reconfiguration.
#
# SET IT IN PRODUCTION ONLY, with no trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://altivance.com
#
# Setting it locally is the classic way to break device testing: a payment
# started on a phone would send that phone to http://localhost:3000, which on a
# phone means the phone itself — a connection error, with the money taken.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SITE_URL=https://altivance.com
